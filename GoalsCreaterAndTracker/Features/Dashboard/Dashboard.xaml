<Window x:Class="GoalsCreaterAndTracker.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoalsCreaterAndTracker"
        mc:Ignorable="d"
        Title="Goals" Height="832" Width="1280">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="307*"/>
            <RowDefinition Height="101*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="435" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <!--Nav pane-->
        <Rectangle Grid.Column="0" Fill="{StaticResource PrimaryColor}" Grid.RowSpan="2"/>
        <StackPanel Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center">
            <Button Width="40" Height="40" Content="Dashboard"/>
            <Button Width="40" Height="40" Content="Goals"/>
            <Button Width="40" Height="40" Content="Tasks"/>
            <Button Width="40" Height="40" Content="Settings"/>
        </StackPanel>


        <!--Goal List Background-->
        <Rectangle Grid.Column="1" Fill="{StaticResource BackgroundColor}" Grid.RowSpan="2" />

        <!--Goal List Grid-->
        <Grid Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="70" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Goal Label-->
            <Label Content="Goals" Style="{StaticResource H1}" IsHitTestVisible="False"/>

            <!--Add New Goal Button-->
            <Button Content="Add New Goal" Style="{StaticResource AddGoalButton}" />

            <!--Search Task Bar-->
            <TextBox Grid.Row="1" HorizontalAlignment="Center" FontSize="16" Height="50" Width="400" Style="{StaticResource TxtBox}" />
            <Label Grid.Row="1" Content="Search Goals..." HorizontalAlignment="Left" Margin="40,18,0,2" FontSize="16" Width="400" Style="{StaticResource TxtBoxLabel}" />
            <Button Grid.Row="1" Content="Search" HorizontalAlignment="Right" VerticalAlignment="Center" Width="50" Height="50" Style="{StaticResource AddGoalButton}" />

            <!--List View For Goal Items-->
            <ListView Grid.Row="2" Background="Transparent" Margin="0 20"/>
        </Grid>

        <!--Goal Details-->
        <Grid Grid.Column="2" Grid.RowSpan="2" Background="{StaticResource BackgroundColor}" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Goal Details" Style="{StaticResource H1}" IsHitTestVisible="False"/>
                <Border Grid.Row="0" BorderBrush="{StaticResource AccentColor}" BorderThickness="0,0,0,1" Margin="20,0">
                    <!--Goal Priority-->
                    <Label Content="Priority:" Style="{StaticResource TxtBoxLabel}" HorizontalAlignment="Right"/>
                </Border>

                <!--Description-->
                <ScrollViewer Grid.Row="1" BorderBrush="{StaticResource AccentColor}" BorderThickness="0,1,0,0" Margin="0 40">
                    <TextBlock Text="This is a simple description for the goal." HorizontalAlignment="Left"/>
                </ScrollViewer>

                <!--Due Date-->
                <TextBlock Grid.Row="2" Text="Due Date: 2024-12-31" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
            
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Tasks Check List" IsHitTestVisible="False"/>
                <StackPanel Margin="20">
                    <!-- Goal Details Checklist -->
                    <ListView Margin="0 20" Background="Transparent"/>
                </StackPanel>
            </Grid>
            
            <!--Goal View Buttons-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Complete Goal" Style="{StaticResource AddGoalButton}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Edit Goal" Style="{StaticResource AddGoalButton}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Delete Goal" Style="{StaticResource AddGoalButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <!--Goal Status Bar-->
        <Rectangle Grid.Column="3" Fill="{StaticResource AccentColor}" Grid.RowSpan="2" />

        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="230" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="140" />
            </Grid.RowDefinitions>
        </Grid>
    </Grid>
</Window>
