<Window x:Class="GoalsCreaterAndTracker.Features.AddGoal.NewGoalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoalsCreaterAndTracker.Features.AddGoal"
        mc:Ignorable="d"
        Title="NewGoalWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="GoalNameTextBox" Width="200" Height="30" Margin="10"/>
        <Button Content="Add Goal" Width="100" Height="30" Margin="10,50,0,0" Click="AddGoalButton_Click"/>
    </Grid>
</Window>
