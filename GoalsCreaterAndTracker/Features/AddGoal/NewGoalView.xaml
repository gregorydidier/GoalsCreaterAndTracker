<UserControl x:Class="GoalsCreaterAndTracker.Features.AddGoal.NewGoalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800">

    <!-- Use Resources to avoid repeating margins and heights -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabelStyle">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="700">

            <!-- Page Title -->
            <TextBlock Text="Create New Goal" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- AI Creation Section -->
            <TextBlock Text="Create with AI" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBox x:Name="AiPromptTextBox" 
                     Height="80" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     Padding="8"
                     Text="e.g. I want to learn Python and become comfortable building web applications within 3 months"/>
            <Button x:Name="GenerateAiGoalButton"
                Content="Generate Goal with AI"
                Height="35"
                Padding="16,0"
                HorizontalAlignment="Right"
                Margin="0,8,0,0"/> 
            <!-- Goal Details Section -->
            <TextBlock Text="Goal Details" Style="{StaticResource SectionHeaderStyle}"/>

            <TextBlock Text="Goal Title" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="GoalNameTextBox" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>

            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="GoalDescriptionTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="6"/>

            <!-- Metadata Row (UniformGrid divides space equally) -->
            <UniformGrid Columns="2" Margin="0,10,0,0">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Priority" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="GoalPriorityComboBox" Height="32" SelectedIndex="1">
                        <ComboBoxItem Content="Low"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="High"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Category" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="GoalCategoryComboBox" Height="32" SelectedIndex="0">
                        <ComboBoxItem Content="Personal"/>
                        <ComboBoxItem Content="Work"/>
                        <ComboBoxItem Content="Health"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,10,10,0">
                    <TextBlock Text="Start Date" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="GoalStartDatePicker" Height="32"/>
                </StackPanel>

                <StackPanel Margin="10,10,0,0">
                    <TextBlock Text="Target End Date" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="GoalEndDatePicker" Height="32"/>
                </StackPanel>
            </UniformGrid>

            <!-- Goal Steps Section -->
            <TextBlock Text="Goal Steps" Style="{StaticResource SectionHeaderStyle}"/>

            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="8">
                <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StepsItemsControl">
                        <ItemsControl.ItemsSource>
                            <CompositeCollection>
                                <!-- Add Step -->
                                <Button x:Name="AddStepButton" 
                                    Content="+ Add Goal Step" 
                                    Height="34" 
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"/>

                                <!-- 2. Your collection of Goal Steps -->
                                <CollectionContainer x:Name="StepsCollectionContainer"/>
                            </CompositeCollection>
                        </ItemsControl.ItemsSource>

                        <!-- Layout for each individual Goal Step -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Step Name stretches to fill space -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Action Buttons take only the space they need -->
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Goal Step Name -->
                                        <TextBox Grid.Column="0" 
                                             Text="{Binding StepName, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="30" 
                                             VerticalContentAlignment="Center"
                                             Padding="6,0"
                                             Margin="0,0,8,0"/>

                                        <!-- Move Up Button -->
                                        <Button Grid.Column="1" 
                                            Content="↑" 
                                            Width="30" 
                                            Height="30" 
                                            ToolTip="Move Up"
                                            Margin="0,0,4,0"/>

                                        <!-- Move Down Button -->
                                        <Button Grid.Column="2" 
                                            Content="↓" 
                                            Width="30" 
                                            Height="30" 
                                            ToolTip="Move Down"
                                            Margin="0,0,4,0"/>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="3" 
                                            Content="✕" 
                                            Width="30" 
                                            Height="30" 
                                            ToolTip="Delete Step"
                                            Foreground="Crimson"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
