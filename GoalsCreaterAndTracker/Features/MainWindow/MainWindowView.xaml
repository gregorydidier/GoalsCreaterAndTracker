<Window x:Class="GoalsCreaterAndTracker.Features.MainWindow.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoalsCreaterAndTracker.Features.MainWindow"
        xmlns:dashboard="clr-namespace:GoalsCreaterAndTracker.Features.Dashboard"
        xmlns:newgoal="clr-namespace:GoalsCreaterAndTracker.Features.AddGoal"
        mc:Ignorable="d"
        Title="Goals" Height="870" Width="1290">

    <Window.Resources>
        <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
            <dashboard:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type newgoal:NewGoalViewModel}">
            <newgoal:NewGoalView />
        </DataTemplate>
    </Window.Resources>

    <!-- Single root container for the Window -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: Fixed-width navigation sidebar -->
            <ColumnDefinition Width="80" />
            <!-- Column 1: Main content area that fills the rest of the window -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Persistent Navigation Sidebar (Column 0) -->
        <Rectangle Grid.Column="0" Fill="{StaticResource PrimaryColor}" />
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <Button Width="40" Height="40" Content="Dashboard" 
                    Command="{Binding NavigateToDashboardCommand}" />
            <Button Width="40" Height="40" Content="Completed Goals" 
                    Command="{Binding NavigateToCompletedGoalsCommand}" />
            <Button Width="40" Height="40" Content="Metrics" 
                    Command="{Binding NavigateToMetricsCommand}" />
            <Button Width="40" Height="40" Content="Settings" 
                    Command="{Binding NavigateToSettingsCommand}" />
        </StackPanel>

        <!-- Swappable Page Area (Column 1) -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>