<Window x:Class="GoalsCreaterAndTracker.Features.MainWindow.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoalsCreaterAndTracker.Features.MainWindow"
        xmlns:dashboard="clr-namespace:GoalsCreaterAndTracker.Features.Dashboard"
        xmlns:newgoal="clr-namespace:GoalsCreaterAndTracker.Features.AddGoal"
        mc:Ignorable="d"
        Title="Goals" Height="870" Width="1290">
    <Window.Resources>
        <!-- Automatically renders DashboardView when CurrentViewModel is DashboardViewModel -->
        <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
            <dashboard:DashboardView />
        </DataTemplate>

        <!-- Automatically renders NewGoalView when CurrentViewModel is NewGoalViewModel -->
        <DataTemplate DataType="{x:Type newgoal:NewGoalViewModel}">
            <newgoal:NewGoalView />
        </DataTemplate>
    </Window.Resources>

        <!-- This acts like the browser viewport and swaps views automatically -->
    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
