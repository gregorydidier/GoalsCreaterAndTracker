<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryColor" Color="#FF1b4c8d"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#FF91d8ff"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="TextColor" Color="#FF162f55"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FF1b4c8d"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#FFB00020"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#FF9AB368"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFFF9800"/>
    <SolidColorBrush x:Key="DisabledColor" Color="#FFE8EED9"/>
    <SolidColorBrush x:Key="ShadowColor" Color="#FF000000"/>
</ResourceDictionary>