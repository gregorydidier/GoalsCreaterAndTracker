<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryColor" Color="#FF6200EE"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#FF03DAC5"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextColor" Color="#FF000000"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FFFFC107"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#FFB00020"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFFF9800"/>
    <SolidColorBrush x:Key="InfoColor" Color="#FF2196F3"/>
    <SolidColorBrush x:Key="DisabledColor" Color="#FF9E9E9E"/>
    <SolidColorBrush x:Key="HighlightColor" Color="#FF00BCD4"/>
    <SolidColorBrush x:Key="ShadowColor" Color="#FF000000"/>
</ResourceDictionary>